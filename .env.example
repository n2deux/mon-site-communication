# URL publique du site (sans slash final) — utilisée pour le SEO, l'Open Graph et le sitemap
NEXT_PUBLIC_SITE_URL=https://n2studio.one

# --- Réception des demandes du formulaire ---
# Option A (recommandée) : Resend — https://resend.com
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=votre-adresse@domaine.fr
# CONTACT_FROM_EMAIL=site@votre-domaine.fr   # domaine vérifié dans Resend

# Option B : Formspree — https://formspree.io (aucune clé côté serveur)
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Aucune des deux n'est configurée -> le formulaire renvoie un message clair
# invitant le visiteur à écrire directement par email.
